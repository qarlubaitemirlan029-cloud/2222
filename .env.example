# === CineVerse Environment Variables ===

# Session secret (any random string)
SESSION_SECRET=your-random-secret-here

# Kinopoisk API key (https://kinopoiskapiunofficial.tech)
KINOPOISK_API_KEY=55308c84-935b-42db-bc37-18016c3a17f6

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# VK OAuth (https://vk.com/editapp?act=create)
VK_APP_ID=
VK_APP_SECRET=

# Port (Railway sets this automatically)
PORT=3000
